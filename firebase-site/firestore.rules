rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return signedIn()
        && currentRole() in ["teacher", "admin"];
    }

    function isContentAdmin() {
      return signedIn()
        && currentRole() == "admin";
    }

    match /roles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /chapters/{chapterId} {
      allow read: if signedIn()
        && (resource.data.released == true || isTeacher());
      allow create, delete: if isContentAdmin();
      allow update: if isContentAdmin()
        || (isTeacher()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["released", "updatedAt"])
          && request.resource.data.released is bool);
    }

    match /users/{userId}/state/{stateId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
